# Copy to .env and adjust. Every setting is optional.

# Port on the host for the web app (when not using Caddy).
SPUR_PORT=4219   # 42.19 km, a marathon

# The sign-in page offers "Create an account", so family or friends can make
# their own (each account's runs are private). Set to true to turn that off,
# for example once everyone has an account.
SPUR_DISABLE_SIGNUP=false

# Set to true only behind a reverse proxy (Caddy, Nginx, Traefik) so spur
# trusts its X-Forwarded-* headers for HTTPS detection and rate limiting.
SPUR_TRUST_PROXY=false

# Secure cookies: auto (when served over HTTPS), true or false.
SPUR_COOKIE_SECURE=auto

# How long you stay signed in, in days.
SPUR_SESSION_DAYS=90

# Time zone of the server, e.g. Europe/Paris.
TZ=UTC

# Only for docker-compose.caddy.yml: your domain, e.g. run.example.org
SPUR_DOMAIN=
